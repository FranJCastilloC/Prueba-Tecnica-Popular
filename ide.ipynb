            "source": "from funciones.estrategia import analizar_crosssell\nimport matplotlib.pyplot as plt\nimport numpy as np\n\ncs = analizar_crosssell(datos[\"tx_full\"])\n\nhm = cs[\"heatmap\"]\nfig, axes = plt.subplots(1, 2, figsize=(16, 5))\nfig.suptitle(\"An\u00e1lisis de Cross-sell \u2014 Presencia y Oportunidades de Producto\", fontsize=13, fontweight=\"bold\")\n\n# Subplot 1: Heatmap presencia cliente \u00d7 producto\nax0 = axes[0]\nmat = np.array(hm[\"values\"])\nax0.imshow(mat, aspect=\"auto\", cmap=\"Blues\", vmin=0, vmax=1)\nax0.set_xticks(range(len(hm[\"productos\"])))\nax0.set_xticklabels(hm[\"productos\"], rotation=45, ha=\"right\", fontsize=8)\nax0.set_yticks([])\nax0.set_xlabel(\"Producto\")\nax0.set_ylabel(\"Clientes (ordenados por volumen)\")\nax0.set_title(\"Presencia por cliente (azul = tiene el producto)\", fontweight=\"bold\")\n\n# Subplot 2: Oportunidades por producto\nax1 = axes[1]\nprods = list(cs[\"top_por_producto\"].keys())\nvals  = list(cs[\"top_por_producto\"].values())\ncolors = [\"#5d8ef7\" if i % 2 == 0 else \"#6bc7b0\" for i in range(len(prods))]\nbars = ax1.barh(prods, vals, color=colors, alpha=0.85)\nax1.set_xlabel(\"Clientes sin este producto\")\nax1.set_title(\"Productos con mayor oportunidad de cross-sell\", fontweight=\"bold\")\nax1.axvline(50, color=\"#d96d66\", linestyle=\"--\", linewidth=1.5, label=\"50% de clientes\")\nfor bar, v in zip(bars, vals):\n    ax1.text(bar.get_width() + 0.5, bar.get_y() + bar.get_height() / 2,\n             str(v), va=\"center\", fontsize=9)\nax1.legend()\n\nplt.tight_layout()\nplt.show()\n\nprint(f\"\\nResumen cross-sell:\")\nprint(f\"  Total oportunidades : {cs['total_oportunidades']} clientes\")\nprint(f\"  Ingreso potencial   : ${cs['ingreso_potencial_total']:,.0f}\")\nprint(f\"\\nTop 5 recomendaciones:\")\nfor o in cs[\"oportunidades\"][:5]:\n    tiene = \", \".join(o[\"productos_actuales\"][:3])\n    print(f\"  Cliente {o['id_cliente']:4d} ({o['segmento']:12s}) \u2192 {o['top_recomendacion']:15s} \u00b7 ${o['ingreso_estimado']:,.0f}\")\n"
